# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is a placeholder — no real credential belongs in this file.

# ── Server ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/taskflow

# ── Auth: two tokens, two different secrets. Never reuse one for the other.
JWT_SECRET=your_access_token_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRE=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ── AI provider ───────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works (Groq, Gemini, OpenRouter, local Ollama).
# An unset or "your_..._here" key means "no AI configured" — every feature
# degrades to its deterministic fallback rather than erroring.
AI_API_KEY=your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1

# Model for every feature that is not routed elsewhere. Unset falls back to
# DEFAULT_MODEL in config/aiModels.js. Must be a model in CATALOG.
AI_MODEL=openai/gpt-oss-120b

# Per-feature model routing — OPT-IN, and currently routing NOTHING.
# FEATURE_MODEL_ENV in config/aiModels.js is empty: the evidence that justified
# routing decompose to a cheaper model was measured on llama-3.1-8b-instant,
# which Groq retired 2026-08-16, so it no longer supports any claim. Re-run the
# decompose suite against a current model before adding a route back.
AI_MODEL_CHEAP=

# Boot refuses to start on a model name that is retired or unknown (this is how
# a dead AI_MODEL gets caught at deploy time instead of as a 502 later). Set
# this to 1 to downgrade that to a warning when trying a brand-new model.
AI_ALLOW_UNKNOWN_MODEL=

# Daily token budget shown on /ops. Groq's free tier is ~100k/day per model.
TOKEN_BUDGET=100000

# Separate key for eval runs, so a full suite (~63k tokens) can never starve
# the running app. run.js maps this onto AI_API_KEY for its own process only.
EVAL_API_KEY=

# ── Email (optional) ──────────────────────────────────────────────────────
# Missing SMTP vars disable assignment emails rather than breaking the app.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
MAIL_FROM="TaskFlow <no-reply@example.com>"

# ── Uploads (optional) ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_key_here
CLOUDINARY_API_SECRET=your_cloudinary_secret_here
