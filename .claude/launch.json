{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "backend",
      "port": 5001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "backend-nodemon-free",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "backend",
      "port": 5001
    },
    {
      "name": "backend-localdb",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "MONGO_URI=mongodb://127.0.0.1:27019/taskflow_mobile node server.js"
      ],
      "cwd": "backend",
      "port": 5001
    }
  ]
}
